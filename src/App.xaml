<Application
    x:Class="SophiApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SophiApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Keeps key combinations in the titles of the settings on one line -->
            <converters:UnbrokenShortcuts x:Key="UnbrokenShortcutsConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Styles/ScrollView.xaml" />
                <ResourceDictionary Source="/Styles/SettingTemplates.xaml" />
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
                <ResourceDictionary Source="/Styles/Themes.xaml" />
                <ResourceDictionary Source="/Styles/Thickness.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
