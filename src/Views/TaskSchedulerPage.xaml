<Page
    x:Class="SophiApp.Views.TaskSchedulerPage"
    x:Name="PageTaskScheduler"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:SophiApp.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:SophiApp.ControlTemplates"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SophiApp.ViewModels"
    xmlns:views="using:SophiApp.Views"
    d:DataContext="{d:DesignInstance Type=views:TaskSchedulerPage}"
    mc:Ignorable="d"
    SizeChanged="PageTaskScheduler_SizeChanged">

    <ScrollView x:Name="TaskSchedulerScrollView">
        <StackPanel IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                    Margin="{StaticResource PageBottomMargin}">
            <!-- The notes can be closed. They are as wide as the cards -->
            <Grid Margin="0, 0, 24, 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <InfoBar x:Uid="Page_AboutCurrentState"
                             helpers:InfoBarHelper.FormattedMessage="True"
                             Severity="Informational"
                             IsOpen="{x:Bind Notes.CurrentStateIsOpen, Mode=TwoWay}"
                             Visibility="{x:Bind Notes.CurrentStateIsOpen, Mode=OneWay}"
                             Margin="0, 0, 0, 4"/>
                    <InfoBar x:Uid="TaskSchedulerPage_AboutTasks"
                             helpers:InfoBarHelper.FormattedMessage="True"
                             Severity="Informational"
                             IsOpen="{x:Bind Notes.TasksIsOpen, Mode=TwoWay}"
                             Visibility="{x:Bind Notes.TasksIsOpen, Mode=OneWay}"
                             Margin="0, 0, 0, 4"/>
                </StackPanel>
            </Grid>
            <Grid Margin="{StaticResource UIControlsPageRightMargin}">
                <!-- On a wide window the cards do not stretch over all of it -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{x:Bind Models, Mode=OneWay}"
                              ItemTemplateSelector="{StaticResource SettingTemplateSelector}"
                              IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button x:Uid="TaskSchedulerPage_OpenTaskScheduler"
                        Grid.Row="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="0, 20, 0, 20"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenTaskScheduler_Command, Mode=OneWay}"/>
            </Grid>
        </StackPanel>
    </ScrollView>
</Page>
