<Page x:Class="SophiApp.Views.SettingsPage"
      x:Name="PageSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:SophiApp.ControlTemplates"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      mc:Ignorable="d">

    <ScrollView>
        <StackPanel IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                    Margin="{StaticResource SettingsListMargin}"
                    Spacing="4">
            <TextBlock x:Uid="Page_Settings" Style="{StaticResource PageTitleTextStyle}"/>
            <controls:MadeForWindows Margin="2, 0, 0, 10"/>

            <toolkit:SettingsExpander x:Uid="SettingsPage_FontOptions"
                                      IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8E9;"/>
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard x:Uid="SettingsPage_TitleFontSize">
                        <Slider Width="200"
                                Minimum="{x:Bind ViewModel.FontOptions.TitleTextMinSize, Mode=OneWay}"
                                Maximum="{x:Bind ViewModel.FontOptions.TitleTextMaxSize, Mode=OneWay}"
                                Value="{x:Bind ViewModel.FontOptions.TitleTextSize, Mode=TwoWay}"
                                StepFrequency="2"/>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="SettingsPage_DescriptionFontSize">
                        <Slider Width="200"
                                Minimum="{x:Bind ViewModel.FontOptions.DescriptionTextMinSize, Mode=OneWay}"
                                Maximum="{x:Bind ViewModel.FontOptions.DescriptionTextMaxSize, Mode=OneWay}"
                                Value="{x:Bind ViewModel.FontOptions.DescriptionTextSize, Mode=TwoWay}"
                                StepFrequency="2"/>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsCard x:Uid="SettingsPage_SelectedTheme">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;"/>
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="200"
                          ItemsSource="{x:Bind ViewModel.Themes, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                          DisplayMemberPath="Description"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard x:Uid="SettingsPage_ShowLogPage">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE90F;"/>
                </toolkit:SettingsCard.HeaderIcon>
                <CheckBox x:Name="ShowLogPageCheckBox"
                          MinWidth="0"
                          IsChecked="{x:Bind ViewModel.LogPageVisibility, Mode=OneWay}"
                          Command="{x:Bind ViewModel.LogPageVisibilityCommand, Mode=OneWay}"
                          CommandParameter="{Binding Path=IsChecked, ElementName=ShowLogPageCheckBox}"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsExpander x:Uid="SettingsPage_AboutApp"
                                      IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE946;"/>
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <StackPanel>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenLatestAppRelease_Command}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/AppLogo.svg" Width="16" Height="16"/>
                                    <TextBlock Text="{x:Bind ViewModel.Version, Mode=OneWay}"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenAppGitHubPage_Command}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/GitHub.svg" Width="16" Height="16"/>
                                    <TextBlock x:Uid="App_GitHub"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenAppTelegramPage_Command}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/Telegram.svg" Width="16" Height="16"/>
                                    <TextBlock x:Uid="App_Telegram"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenAppDiscordPage_Command}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/Discord.svg" Width="16" Height="16"/>
                                    <TextBlock x:Uid="App_Discord"/>
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander x:Uid="SettingsPage_Team"
                                      IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE716;"/>
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <StackPanel>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenAppProjectManagerPage_Command}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/GitHub.svg" Width="16" Height="16"/>
                                    <TextBlock x:Uid="AppTeam_ProjectLead"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenAppDeveloperPage_Command}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/GitHub.svg" Width="16" Height="16"/>
                                    <TextBlock x:Uid="AppTeam_Developer"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenAppUxDeveloperPage_Command}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/LinkedIn.svg" Width="16" Height="16"/>
                                    <TextBlock x:Uid="AppTeam_UxDeveloper"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenAppUiDeveloperPage_Command}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/LinkedIn.svg" Width="16" Height="16"/>
                                    <TextBlock x:Uid="AppTeam_UiDeveloper"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenAppAnimationDeveloperPage_Command}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/LinkedIn.svg" Width="16" Height="16"/>
                                    <TextBlock x:Uid="AppTeam_AnimationDeveloper"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenAppTesterPage_Command}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="/Assets/GitHub.svg" Width="16" Height="16"/>
                                    <TextBlock x:Uid="AppTeam_Tester"/>
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollView>
</Page>
