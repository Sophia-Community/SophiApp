<Page x:Class="SophiApp.Views.SettingsPage"
      x:Name="PageSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:SophiApp.ControlTemplates"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:helpers="using:SophiApp.Helpers"
      mc:Ignorable="d">


    <ScrollView>
        <Grid Margin="{StaticResource SettingsListMargin}">
            <!-- On a wide window the cards do not stretch over all of it -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}"/>
            </Grid.ColumnDefinitions>
            <StackPanel IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                        Spacing="4">
                <!-- The small animated logo, with the slogan and the version beside it -->
                <Grid ColumnSpacing="20"
                      Margin="2, 0, 0, 12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Height="56"
                             VerticalAlignment="Center">
                        <controls:AnimatedLogo/>
                    </Viewbox>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <controls:Slogan/>
                        <HyperlinkButton Padding="0"
                                         Command="{x:Bind ViewModel.OpenLatestAppRelease_Command}">
                            <TextBlock Text="{x:Bind ViewModel.Version, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </HyperlinkButton>
                    </StackPanel>
                </Grid>

                <!-- Where to write about a bug: right under the logo -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Margin="2, 0, 0, 8">
                    <TextBlock x:Uid="SettingsPage_ReportBug"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <controls:SupportLinks/>
                </StackPanel>

                <!-- The theme, and whether it is kept for the next start -->
                <toolkit:SettingsExpander x:Uid="SettingsPage_SelectedTheme"
                                          IsExpanded="True">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE790;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <helpers:NoWheelComboBox Style="{StaticResource DefaultComboBoxStyle}"
                                             MinWidth="200"
                                             ItemsSource="{x:Bind ViewModel.Themes, Mode=OneWay}"
                                             SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                             DisplayMemberPath="Description"
                                             DropDownOpened="ThemeSelector_DropDownOpened"/>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Left">
                            <CheckBox x:Uid="SettingsPage_RememberTheme"
                                      IsChecked="{x:Bind ViewModel.RememberTheme, Mode=TwoWay}"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <StackPanel>
                    <toolkit:SettingsCard x:Uid="SettingsPage_Language">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF2B7;"/>
                        </toolkit:SettingsCard.HeaderIcon>
                        <helpers:NoWheelComboBox Style="{StaticResource DefaultComboBoxStyle}"
                                                 MinWidth="200"
                                                 ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                                 SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                                 DisplayMemberPath="Name"
                                                 DropDownOpened="ThemeSelector_DropDownOpened"/>
                    </toolkit:SettingsCard>
                    <!-- A new language is used at once: the settings are read again, and what is chosen but not applied is dropped -->
                    <InfoBar x:Uid="SettingsPage_LanguageDropsChoices"
                             Margin="0, 2, 0, 0"
                             Severity="Informational"
                             IsClosable="False"
                             IsOpen="{x:Bind Choices.HasChoices, Mode=OneWay}"
                             Visibility="{x:Bind Choices.HasChoices, Mode=OneWay}"/>
                </StackPanel>

                <!-- A restore point is created by the app itself; the window of Windows is for managing the points -->
                <StackPanel>
                    <toolkit:SettingsExpander x:Uid="SettingsPage_RestorePoint"
                                              IsExpanded="True">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE81C;"/>
                        </toolkit:SettingsExpander.HeaderIcon>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <HyperlinkButton x:Uid="Button_OpenSystemProtection"
                                             Command="{x:Bind Choices.OpenSystemProtection_Command}"/>
                            <Button x:Uid="Button_CreateRestorePoint"
                                    MinWidth="100"
                                    Command="{x:Bind Choices.CreateRestorePoint_Command}"/>
                        </StackPanel>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard ContentAlignment="Left">
                                <CheckBox x:Uid="SettingsPage_SkipRestorePointQuestion"
                                          IsChecked="{x:Bind Choices.SkipRestorePointQuestion, Mode=TwoWay}"/>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                    <InfoBar x:Uid="SettingsPage_RestorePointCreated"
                             Margin="0, 2, 0, 0"
                             Severity="Success"
                             IsOpen="{x:Bind Choices.RestorePointCreatedIsVisible, Mode=TwoWay}"
                             Visibility="{x:Bind Choices.RestorePointCreatedIsVisible, Mode=OneWay}"/>
                    <InfoBar x:Uid="SettingsPage_RestorePointNotCreated"
                             Margin="0, 2, 0, 0"
                             Severity="Error"
                             IsOpen="{x:Bind Choices.RestorePointNotCreatedIsVisible, Mode=TwoWay}"
                             Visibility="{x:Bind Choices.RestorePointNotCreatedIsVisible, Mode=OneWay}"/>
                </StackPanel>

                <toolkit:SettingsExpander x:Uid="SettingsPage_Team"
                                          IsExpanded="True">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE716;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <HyperlinkButton Command="{x:Bind ViewModel.OpenAppProjectManagerPage_Command}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image Source="/Assets/GitHub.svg" Width="16" Height="16"/>
                                        <TextBlock x:Uid="AppTeam_ProjectLead"/>
                                    </StackPanel>
                                </HyperlinkButton>
                                <HyperlinkButton Command="{x:Bind ViewModel.OpenAppDeveloperPage_Command}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image Source="/Assets/GitHub.svg" Width="16" Height="16"/>
                                        <TextBlock x:Uid="AppTeam_Developer"/>
                                    </StackPanel>
                                </HyperlinkButton>
                                <HyperlinkButton Command="{x:Bind ViewModel.OpenAppUxDeveloperPage_Command}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image Source="/Assets/LinkedIn.svg" Width="16" Height="16"/>
                                        <TextBlock x:Uid="AppTeam_UxDeveloper"/>
                                    </StackPanel>
                                </HyperlinkButton>
                                <HyperlinkButton Command="{x:Bind ViewModel.OpenAppTesterPage_Command}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image Source="/Assets/GitHub.svg" Width="16" Height="16"/>
                                        <TextBlock x:Uid="AppTeam_Tester"/>
                                    </StackPanel>
                                </HyperlinkButton>
                                <HyperlinkButton Command="{x:Bind ViewModel.OpenAppSupporterPage_Command}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image Source="/Assets/GitHub.svg" Width="16" Height="16"/>
                                        <TextBlock x:Uid="AppTeam_Supporter"/>
                                    </StackPanel>
                                </HyperlinkButton>
                                <HyperlinkButton Command="{x:Bind ViewModel.OpenAppPromoterPage_Command}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image Source="/Assets/LinkedIn.svg" Width="16" Height="16"/>
                                        <TextBlock x:Uid="AppTeam_Promoter"/>
                                    </StackPanel>
                                </HyperlinkButton>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

            </StackPanel>
        </Grid>
    </ScrollView>
</Page>
