<Page
    x:Class="SophiApp.Views.FatalErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SophiApp.Views"
    xmlns:controls="using:SophiApp.ControlTemplates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <MenuFlyout x:Name="FatalErrorPageCommandsFlyout">
            <MenuFlyoutItem x:Uid="Page_ContextMenu_OpenLogFile"
                            Icon="OpenFile"
                            Click="FatalErrorPageOpenLogFile_Clicked"/>
            <MenuFlyoutItem x:Uid="Page_ContextMenu_OpenLogFolder"
                            Icon="Folder"
                            Click="FatalErrorPageOpenLogFolder_Clicked"/>
        </MenuFlyout>
    </Page.Resources>

    <Grid ContextRequested="FatalErrorPage_ContextRequested"
          Background="Transparent"
          RowSpacing="16"
          Margin="0, 8, 0, 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- The page looks like the startup pages: the same small logo, and the stock notice under it -->
        <Viewbox Height="110"
                 HorizontalAlignment="Center">
            <controls:AnimatedLogo/>
        </Viewbox>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="560"
                        HorizontalAlignment="Center"
                        Margin="24, 0, 24, 16">
                <!-- The error cannot be passed by, so the notice has no close button. The log tells what happened -->
                <InfoBar x:Name="ErrorNotice"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Error">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Margin="0, 0, 0, 12">
                        <Button x:Name="OpenLogFileButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="FatalErrorPageOpenLogFile_Clicked"/>
                        <Button x:Name="OpenLogFolderButton"
                                Click="FatalErrorPageOpenLogFolder_Clicked"/>
                    </StackPanel>
                </InfoBar>
                <controls:SupportLinks HorizontalAlignment="Center"
                                       Margin="0, 8, 0, 0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
