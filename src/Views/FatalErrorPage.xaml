<Page
    x:Class="SophiApp.Views.FatalErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SophiApp.Views"
    xmlns:controls="using:SophiApp.ControlTemplates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <MenuFlyout x:Name="FatalErrorPageCommandsFlyout">
            <MenuFlyoutItem x:Uid="Page_ContextMenu_OpenLogFile"
                            Icon="OpenFile"
                            Click="FatalErrorPageOpenLogFile_Clicked"/>
            <MenuFlyoutItem x:Uid="Page_ContextMenu_OpenLogFolder"
                            Icon="Folder"
                            Click="FatalErrorPageOpenLogFolder_Clicked"/>
        </MenuFlyout>
    </Page.Resources>

    <Grid ContextRequested="FatalErrorPage_ContextRequested">
        <!-- The logo keeps its place whatever is shown under it: the page is split into three parts, and the text takes the lower one -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <controls:AnimatedLogo Grid.Row="1"
                               Grid.ColumnSpan="3"
                               HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="2"
                    Grid.Column="1"
                    VerticalAlignment="Top">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Margin="0, 20, 0, 20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="10, 0, 10, 0">
                        <Image Source="/Assets/AppLogo.svg"
                               Width="52"
                               Height="52"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Margin="0, 20, 20, 20">
                        <TextBlock Style="{StaticResource RequirementsFailurePageTextStyle}">
                            <Run x:Uid="AppFatalError_1"/>
                            <Run x:Uid="AppFatalError_2"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <controls:SupportLinks HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
