<Page
    x:Class="SophiApp.Views.ShellPage"
    x:Name="PageShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converter="using:SophiApp.Converters"
    xmlns:helpers="using:SophiApp.Helpers"
    xmlns:views="using:SophiApp.Views"
    xmlns:sys="using:System"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:interaction="using:Microsoft.Xaml.Interactivity"
    Loaded="OnLoaded">

    <Page.Resources>
        <converter:GreaterThanZeroToVisibility x:Key="GreaterThanZeroToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid x:Name="AppTitleBar"
              Canvas.ZIndex="1"
              Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
              VerticalAlignment="Top">
            <Image Source="/Assets/SophiApp.ico"
                   HorizontalAlignment="Left"
                   Width="16"
                   Height="16"/>
            <TextBlock x:Name="AppTitleName"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Margin="24, 0, 0, 0"/>
        </Grid>
        <NavigationView x:Name="NavigationViewControl"
                        Canvas.ZIndex="0"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Visible"
                        IsBackEnabled="{x:Bind views:ShellPage.IsBackAllowed(ViewModel.IsBackEnabled, ViewModel.NavigationViewHitTestVisible), Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedNavigationViewItem, Mode=OneWay}"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        DisplayModeChanged="NavigationViewControl_DisplayModeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavigationItem_Privacy"
                                    helpers:NavigationHelper.NavigateTo="views:PrivacyPage"
                                    IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                                    IsTabStop="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind Choices.InfoBadgeCounters.Privacy, Mode=OneWay}"
                                   Visibility="{x:Bind Choices.InfoBadgeCounters.Privacy, Mode=OneWay, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}"/>
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE705;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavigationItem_Personalization"
                                    helpers:NavigationHelper.NavigateTo="views:PersonalizationPage"
                                    IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                                    IsTabStop="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind Choices.InfoBadgeCounters.Personalization, Mode=OneWay}"
                                   Visibility="{x:Bind Choices.InfoBadgeCounters.Personalization, Mode=OneWay, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}"/>
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE771;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavigationItem_System"
                                    helpers:NavigationHelper.NavigateTo="views:SystemPage"
                                    IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                                    IsTabStop="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind Choices.InfoBadgeCounters.System, Mode=OneWay}"
                                   Visibility="{x:Bind Choices.InfoBadgeCounters.System, Mode=OneWay, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}"/>
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="NavigationItem_UWP_Gaming"
                                    x:Name="UwpGamingItem"
                                    helpers:NavigationHelper.NavigateTo="views:UwpPage"
                                    IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                                    IsTabStop="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind Choices.InfoBadgeCounters.UwpAndGaming, Mode=OneWay}"
                                   Visibility="{x:Bind Choices.InfoBadgeCounters.UwpAndGaming, Mode=OneWay, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}"/>
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavigationItem_TaskScheduler"
                                    helpers:NavigationHelper.NavigateTo="views:TaskSchedulerPage"
                                    IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                                    IsTabStop="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind Choices.InfoBadgeCounters.TaskScheduler, Mode=OneWay}"
                                   Visibility="{x:Bind Choices.InfoBadgeCounters.TaskScheduler, Mode=OneWay, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}"/>
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEFFF;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavigationItem_Security"
                                    helpers:NavigationHelper.NavigateTo="views:SecurityPage"
                                    IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                                    IsTabStop="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind Choices.InfoBadgeCounters.Security, Mode=OneWay}"
                                   Visibility="{x:Bind Choices.InfoBadgeCounters.Security, Mode=OneWay, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}"/>
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE730;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavigationItem_ContextMenu"
                                    helpers:NavigationHelper.NavigateTo="views:ContextMenuPage"
                                    IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                                    IsTabStop="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind Choices.InfoBadgeCounters.ContextMenu, Mode=OneWay}"
                                   Visibility="{x:Bind Choices.InfoBadgeCounters.ContextMenu, Mode=OneWay, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}"/>
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavigationItem_Settings"
                                    helpers:NavigationHelper.NavigateTo="views:SettingsPage"
                                    IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                                    IsTabStop="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <!-- The search stands at the bottom of the menu, above "Settings". While only the icons of the menu are shown,
                 a button stands for the search box: it opens a search box next to itself -->
            <NavigationView.PaneFooter>
                <Grid Height="40"
                      Margin="0, 0, 0, 4">
                    <AutoSuggestBox x:Name="AutoSuggestBox"
                                    x:Uid="AutoSuggestBox"
                                    QueryIcon="Find"
                                    VerticalAlignment="Center"
                                    Margin="16, 0, 16, 0"
                                    IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                                    Loaded="AutoSuggestBox_Loaded"
                                    TextChanged="AutoSuggestBox_TextChanged"
                                    QuerySubmitted="AutoSuggestBox_QuerySubmitted"/>
                    <Button x:Name="SearchButton"
                            x:Uid="SearchButton"
                            Style="{StaticResource NavigationViewPaneSearchButtonStyle}"
                            Width="40"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="4, 0, 0, 0"
                            Visibility="Collapsed"
                            IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}"
                            IsTabStop="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
                        <Button.Flyout>
                            <Flyout x:Name="SearchFlyout"
                                    Placement="RightEdgeAlignedBottom"
                                    helpers:PopupCursor.ResetOnOpen="True">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter"
                                           BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <!-- The acrylic of the menus and the lists is put under the color layer when the page is created -->
                                <Grid x:Name="SearchFlyoutLayers">
                                    <Border Style="{StaticResource PopupTintLayerStyle}"/>
                                    <AutoSuggestBox x:Name="FlyoutSearchBox"
                                                    x:Uid="AutoSuggestBox"
                                                    QueryIcon="Find"
                                                    Width="280"
                                                    Margin="8"
                                                    TextChanged="AutoSuggestBox_TextChanged"
                                                    QuerySubmitted="AutoSuggestBox_QuerySubmitted"/>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Frame x:Name="NavigationFrame"
                       Grid.Row="0"
                       Margin="32, 10, 0, 10"/>
                <StackPanel Grid.Row="1">
                    <!-- While the app is busy only the progress line is shown: the reminder and the question come back when it is done -->
                    <InfoBar x:Name="Panel_RestartReminder"
                             x:Uid="Panel_RestartReminder"
                             Severity="Informational"
                             IsOpen="{x:Bind Choices.RestartReminderIsVisible, Mode=TwoWay}"
                             Visibility="{x:Bind views:ShellPage.GetReminderVisibility(ViewModel.SetUpCustomizationsPanelIsVisible), Mode=OneWay}"/>
                    <Grid x:Name="Panel_ApplyCustomizations"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="0, 1, 0, 0"
                          Padding="16, 8, 24, 8"
                          ColumnSpacing="8"
                          Visibility="{x:Bind views:ShellPage.GetApplyPanelVisibility(Choices.ApplicableModels.Count, ViewModel.SetUpCustomizationsPanelIsVisible), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE946;"
                                  FontSize="16"/>
                        <TextBlock x:Uid="Panel_ApplyCustomizations_Apply"
                                   Grid.Column="1"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"/>
                        <Button x:Uid="Button_Cancel"
                                Grid.Column="2"
                                Command="{x:Bind Choices.Clear_Command, Mode=OneWay}"/>
                        <Button x:Uid="Button_Apply"
                                Grid.Column="3"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind Choices.Apply_Command, Mode=OneWay}"/>
                    </Grid>
                    <Grid x:Name="Panel_SetUpCustomizations"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="0, 1, 0, 0"
                          Padding="16, 12, 24, 12"
                          ColumnSpacing="12">
                        <!-- The status can be long: it takes the free width and is cut with an ellipsis, the progress bar keeps its place on the right -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE946;"
                                  FontSize="16"/>
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="1"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{x:Bind ViewModel.SetUpCustomizationsPanelText, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.SetUpCustomizationsPanelText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="SetUpCustomizationsProgressBar"
                                     Grid.Column="2"
                                     IsIndeterminate="True"
                                     VerticalAlignment="Center"/>
                        <!-- A download can crawl on a slow connection, so it can be given up. The margin keeps the height of the line -->
                        <Button x:Uid="Button_CancelDownload"
                                Grid.Column="3"
                                Margin="0, -6, 0, -6"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.CancelDownload_Command}"
                                Visibility="{x:Bind ViewModel.DownloadCanBeCanceled, Mode=OneWay}"/>
                        <i:Interaction.Behaviors>
                            <interaction:DataTriggerBehavior Binding="{x:Bind ViewModel.SetUpCustomizationsPanelIsVisible, Mode=OneWay}" ComparisonCondition="Equal" Value="False">
                                <interaction:ChangePropertyAction PropertyName="Visibility" Value="Collapsed"/>
                            </interaction:DataTriggerBehavior>
                            <interaction:DataTriggerBehavior Binding="{x:Bind ViewModel.SetUpCustomizationsPanelIsVisible, Mode=OneWay}" ComparisonCondition="Equal" Value="True">
                                <interaction:ChangePropertyAction PropertyName="Visibility" Value="Visible"/>
                            </interaction:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Grid>
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Page>