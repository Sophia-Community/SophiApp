<Page
    x:Class="SophiApp.Views.WslPage"
    x:Name="PageWsl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollView>
        <StackPanel IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
            <Grid x:Name="ItemsContainerGrid"
                  Margin="{StaticResource SettingsListMargin}">
                <ItemsRepeater ItemsSource="{x:Bind Models, Mode=OneWay}"
                               ItemTemplate="{StaticResource SettingTemplateSelector}"
                               VerticalCacheLength="{x:Bind Models.Count, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </Grid>
        </StackPanel>
    </ScrollView>
</Page>
