<Page
    x:Class="SophiApp.Views.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SophiApp.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SophiApp.ControlTemplates"
    mc:Ignorable="d">

    <ScrollView>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Debug"
                           Style="{StaticResource PageTitleTextStyle}"/>
            </StackPanel>
            <Grid>
                <StackPanel>
                    <controls:ContentBlock Title="Debug options"
                                           Height="140"
                                           HorizontalAlignment="Left"
                                           Margin="0, 0, 10, 10">
                        <controls:ContentBlock.Content>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      Margin="0, 0, 15, 5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{x:Bind ViewModel.DebugOptions.ShowFunctionsInfo, Mode=OneWay}"
                                              Command="{x:Bind ViewModel.SetShowFunctionsInfoCommand, Mode=OneWay}"/>
                                    <TextBlock Text="Show functions name and ID"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Margin="0, 0, 5, 1"/>
                                </Grid>
                                <Grid Grid.Row="1"
                                      Margin="0, 0, 15, 5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{x:Bind ViewModel.DebugOptions.DeleteLGPOFile, Mode=OneWay}"
                                              Command="{x:Bind ViewModel.DeleteLGPOFileCommand, Mode=OneWay}"/>
                                    <TextBlock Text="Delete LGPO.txt file"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Margin="0, 0, 5, 1"/>
                                </Grid>
                            </Grid>
                        </controls:ContentBlock.Content>
                    </controls:ContentBlock>

                    <controls:ContentBlock Title="Debug requirement actions"
                                           HorizontalAlignment="Left"
                                           Margin="0, 0, 20, 10">
                        <controls:ContentBlock.Content>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.RequirementActions, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="{Binding Execute.Method.Name}"
                                                         GroupName="RequirementActionsGroup"
                                                         Checked="RequirementActionsRadioButton_Checked"
                                                         ToolTipService.ToolTip="{Binding Execute.Method.Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout ItemsStretch="Fill"
                                                       MinRowSpacing="10"
                                                       MinColumnSpacing="30"
                                                       MaximumRowsOrColumns="3"/>
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </controls:ContentBlock.Content>
                    </controls:ContentBlock>
                    <TeachingTip x:Name="DebugRequirementActionsTip"
                                 IsLightDismissEnabled="False"
                                 PreferredPlacement="Auto"
                                 Subtitle="Restart the app to apply selected action"
                                 HorizontalContentAlignment="Center">
                    </TeachingTip>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollView>
</Page>
