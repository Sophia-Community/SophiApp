<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SophiApp.Views.SearchPage"
    x:Name="PageSearch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SophiApp.Views"
    xmlns:controls="using:SophiApp.ControlTemplates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SophiApp.ViewModels"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
    mc:Ignorable="d">

    <ScrollView x:Name="SearchScrollView">
        <Grid IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
            <StackPanel>
                <Grid x:Name="ItemsContainerGrid"
                      Margin="{StaticResource SettingsListMargin}">
                    <!-- On a wide window the cards do not stretch over all of it -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="SearchItemsRepeater"
                                  ItemsSource="{x:Bind FoundModels, Mode=OneWay}"
                                  ItemTemplateSelector="{StaticResource SettingTemplateSelector}"
                                  IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </StackPanel>
            <Grid x:Name="NothingFoundGrid"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <controls:AnimatedLogo Grid.Row="0"
                                       HorizontalAlignment="Center"/>
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center">
                    <TextBlock x:Uid="SearchPage_NothingFound"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <i:Interaction.Behaviors>
            <i:DataTriggerBehavior Binding="{x:Bind FoundModels.Count, Mode=OneWay}" ComparisonCondition="Equal" Value="0">
                <i:ChangePropertyAction TargetObject="{Binding ElementName=NothingFoundGrid}" PropertyName="Visibility" Value="Visible"/>
                <i:ChangePropertyAction TargetObject="{Binding ElementName=SearchItemsRepeater}" PropertyName="Visibility" Value="Collapsed"/>
            </i:DataTriggerBehavior>
            <i:DataTriggerBehavior Binding="{x:Bind FoundModels.Count, Mode=OneWay}" ComparisonCondition="GreaterThan" Value="0">
                <i:ChangePropertyAction TargetObject="{Binding ElementName=NothingFoundGrid}" PropertyName="Visibility" Value="Collapsed"/>
                <i:ChangePropertyAction TargetObject="{Binding ElementName=SearchItemsRepeater}" PropertyName="Visibility" Value="Visible"/>
            </i:DataTriggerBehavior>
        </i:Interaction.Behaviors>
    </ScrollView>
</Page>
