<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SophiApp.Views.SearchPage"
    x:Name="PageSearch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SophiApp.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:SophiApp.ControlTemplates"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SophiApp.ViewModels"
    xmlns:helpers="using:SophiApp.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="IconCheckBoxTemplate">
            <controls:IconCheckBox Margin="{StaticResource UIControlsPageRightMargin}"
                                   IconIndex="{Binding IconIndex}"
                                   Command="{Binding ElementName=PageSearch, Path=ViewModel.UIModelClicked_Command}"/>
        </DataTemplate>
        <DataTemplate x:Key="TextCheckBoxTemplate">
            <controls:TextCheckBox Margin="{StaticResource UIControlsPageRightMargin}"
                                   Command="{Binding ElementName=PageSearch, Path=ViewModel.UIModelClicked_Command}"/>
        </DataTemplate>
        <DataTemplate x:Key="RadioButtonsGroup2Template">
            <controls:RadioButtonsGroup2 Margin="{StaticResource UIControlsPageRightMargin}"
                                         Command="{Binding ElementName=PageSearch, Path=ViewModel.RadioButtonsGroup2Clicked_Command}"/>
        </DataTemplate>
        <DataTemplate x:Key="RadioButtonsGroup3Template">
            <controls:RadioButtonsGroup3 Margin="{StaticResource UIControlsPageRightMargin}"
                                         Command="{Binding ElementName=PageSearch, Path=ViewModel.RadioButtonsGroup3Clicked_Command}"/>
        </DataTemplate>
        <DataTemplate x:Key="RadioButtonsGroup4Template">
            <controls:RadioButtonsGroup4 Margin="{StaticResource UIControlsPageRightMargin}"
                                         Command="{Binding ElementName=PageSearch, Path=ViewModel.RadioButtonsGroup4Clicked_Command}"/>
        </DataTemplate>
    </Page.Resources>

    <ScrollView x:Name="SearchScrollView">
        <Grid IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Uid="Page_Search" Style="{StaticResource PageTitleTextStyle}"/>
                </StackPanel>
                <Grid x:Name="ItemsContainerGrid">
                    <ItemsRepeater x:Name="SearchItemsRepeater"
                                   ItemsSource="{x:Bind FoundModels, Mode=OneWay}"
                                   VerticalCacheLength="{x:Bind FoundModels.Count, Mode=OneWay}"
                                   Margin="{StaticResource PageBottomMargin}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <helpers:UIDataTemplateSelector IconCheckBox="{StaticResource IconCheckBoxTemplate}"
                                                            TextCheckBox="{StaticResource TextCheckBoxTemplate}"
                                                            RadioButtonsGroup2="{StaticResource RadioButtonsGroup2Template}"
                                                            RadioButtonsGroup3="{StaticResource RadioButtonsGroup3Template}"
                                                            RadioButtonsGroup4="{StaticResource RadioButtonsGroup4Template}"/>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </StackPanel>
            <Grid x:Name="NothingFoundGrid"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Image Grid.Row="0"
                       Source="/Assets/AppLogoBig.svg"
                       Width="373"
                       Height="103"/>
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource UIControlTitleTextStyle}">
                        <Run x:Uid="SearchPage_NothingFound"
                             Foreground="{ThemeResource WindowForeground}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
        <i:Interaction.Behaviors>
            <i:DataTriggerBehavior Binding="{x:Bind ViewModel.FoundModels.Count, Mode=OneWay}" ComparisonCondition="Equal" Value="0">
                <i:ChangePropertyAction TargetObject="{Binding ElementName=NothingFoundGrid}" PropertyName="Visibility" Value="Visible"/>
                <i:ChangePropertyAction TargetObject="{Binding ElementName=SearchItemsRepeater}" PropertyName="Visibility" Value="Collapsed"/>
            </i:DataTriggerBehavior>
            <i:DataTriggerBehavior Binding="{x:Bind ViewModel.FoundModels.Count, Mode=OneWay}" ComparisonCondition="GreaterThan" Value="0">
                <i:ChangePropertyAction TargetObject="{Binding ElementName=NothingFoundGrid}" PropertyName="Visibility" Value="Collapsed"/>
                <i:ChangePropertyAction TargetObject="{Binding ElementName=SearchItemsRepeater}" PropertyName="Visibility" Value="Visible"/>
            </i:DataTriggerBehavior>
        </i:Interaction.Behaviors>
    </ScrollView>
</Page>
