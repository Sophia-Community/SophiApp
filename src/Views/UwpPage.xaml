<Page
    x:Class="SophiApp.Views.UwpPage"
    x:Name="PageUwp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SophiApp.ControlTemplates"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:interaction="using:Microsoft.Xaml.Interactivity"
    xmlns:helpers="using:SophiApp.Helpers"
    xmlns:views="using:SophiApp.Views"
    d:DataContext="{d:DesignInstance Type=views:UwpPage}"
    mc:Ignorable="d"
    SizeChanged="PageUwp_SizeChanged">

    <ScrollView>
        <StackPanel Margin="{StaticResource UIControlsPageRightMargin}"
                    IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Uid="Page_UWP" Style="{StaticResource PageTitleTextStyle}"/>
            </StackPanel>
            <Grid x:Name="UwpAppsNotFoundGrid">
                <controls:IconContentBlock Margin="0, 0, 0, 10">
                    <controls:IconContentBlock.Content>
                        <TextBlock x:Uid="UwpPage_UwpAppsNotFound"
                                   Style="{StaticResource IconContentBlockTextStyle}"
                                   Foreground="{ThemeResource WindowAccent}"
                                   FontSize="{x:Bind ViewModel.FontOptions.TitleTextSize, Mode=OneWay}"/>
                    </controls:IconContentBlock.Content>
                </controls:IconContentBlock>
            </Grid>
            <Grid x:Name="UwpAppsFoundGrid">
                <StackPanel>
                    <controls:IconContentBlock Margin="0, 0, 0, 10">
                        <controls:IconContentBlock.Content>
                            <TextBlock x:Uid="UwpPage_AboutAppIcon"
                                       Style="{StaticResource IconContentBlockTextStyle}"
                                       Foreground="{ThemeResource WindowAccent}"
                                       FontSize="{x:Bind ViewModel.FontOptions.DescriptionTextSize, Mode=OneWay}"/>
                        </controls:IconContentBlock.Content>
                    </controls:IconContentBlock>
                    <StackPanel Orientation="Horizontal"
                                Margin="0, 0, 0, 10">
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource UIControlTitleTextStyle}">
                            <Run x:Uid="UwpPage_ForAllUsers"
                                 FontSize="{Binding Path=ViewModel.FontOptions.TitleTextSize, ElementName=PageUwp}"/>
                        </TextBlock>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.UwpForAllUsersState, Mode=OneWay}"
                                      OnContent="{x:Null}"
                                      OffContent="{x:Null}"
                                      Margin="10, 0, 10, -3">
                            <interaction:Interaction.Behaviors>
                                <interaction:EventTriggerBehavior EventName="Toggled">
                                    <interaction:InvokeCommandAction Command="{x:Bind ViewModel.UwpForAllUsersClicked_Command}"/>
                                </interaction:EventTriggerBehavior>
                            </interaction:Interaction.Behaviors>
                        </ToggleSwitch>
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.UwpAppsModels, Mode=OneWay}"
                                   VerticalCacheLength="{x:Bind ViewModel.UwpAppsModels.Count, Mode=OneWay}"
                                   HorizontalAlignment="Left"
                                   Margin="0, 0, 0, 10">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <controls:UwpAppCheckBox Command="{Binding ElementName=PageUwp, Path=ViewModel.UIUwpAppModelClicked_Command}"
                                                         CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="UwpItemsContainerLayoutGrid"
                                               ItemsStretch="Fill"
                                               MinRowSpacing="10"
                                               MinColumnSpacing="10"
                                               MaximumRowsOrColumns="5"
                                               MinItemHeight="60"
                                               MinItemWidth="300"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Uid="Page_UWP_Gaming" Style="{StaticResource PageTitleTextStyle}"/>
            </StackPanel>
            <ItemsRepeater ItemsSource="{Binding ElementName=PageUwp, Path=GamingModels}"
                           VerticalCacheLength="{Binding ElementName=PageUwp, Path=GamingModels.Count}"
                           Margin="{StaticResource PageBottomMargin}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <controls:TextCheckBox Command="{Binding ElementName=PageUwp, Path=ViewModel.UIModelClicked_Command}"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
        <interactivity:Interaction.Behaviors>
            <interaction:DataTriggerBehavior Binding="{x:Bind ViewModel.UwpAppsModels.Count, Mode=OneWay}" ComparisonCondition="Equal" Value="0">
                <interaction:ChangePropertyAction TargetObject="{Binding ElementName=UwpAppsNotFoundGrid}" PropertyName="Visibility" Value="Visible"/>
                <interaction:ChangePropertyAction TargetObject="{Binding ElementName=UwpAppsFoundGrid}" PropertyName="Visibility" Value="Collapsed"/>
            </interaction:DataTriggerBehavior>
            <interaction:DataTriggerBehavior Binding="{x:Bind ViewModel.UwpAppsModels.Count, Mode=OneWay}" ComparisonCondition="GreaterThan" Value="0">
                <interaction:ChangePropertyAction TargetObject="{Binding ElementName=UwpAppsFoundGrid}" PropertyName="Visibility" Value="Visible"/>
                <interaction:ChangePropertyAction TargetObject="{Binding ElementName=UwpAppsNotFoundGrid}" PropertyName="Visibility" Value="Collapsed"/>
            </interaction:DataTriggerBehavior>
        </interactivity:Interaction.Behaviors>
    </ScrollView>
</Page>
