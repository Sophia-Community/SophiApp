<Page
    x:Class="SophiApp.Views.SystemPage"
    x:Name="PageSystem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:SophiApp.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollView>
        <StackPanel IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
            <!-- The notes can be closed. They are as wide as the cards -->
            <Grid Margin="0, 0, 24, 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <InfoBar x:Uid="Page_AboutCurrentState"
                             helpers:InfoBarHelper.FormattedMessage="True"
                             Severity="Informational"
                             IsOpen="{x:Bind Notes.CurrentStateIsOpen, Mode=TwoWay}"
                             Visibility="{x:Bind Notes.CurrentStateIsOpen, Mode=OneWay}"
                             Margin="0, 0, 0, 4"/>
                    <InfoBar x:Uid="Page_AboutPolicies"
                             helpers:InfoBarHelper.FormattedMessage="True"
                             Severity="Informational"
                             IsOpen="{x:Bind Notes.PoliciesIsOpen, Mode=TwoWay}"
                             Visibility="{x:Bind Notes.PoliciesIsOpen, Mode=OneWay}"
                             Margin="0, 0, 0, 4"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="ItemsContainerGrid"
                  Margin="{StaticResource SettingsListMargin}">
                <!-- On a wide window the cards do not stretch over all of it -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource SettingsContentMaxWidth}"/>
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{x:Bind Items}"
                              ItemTemplateSelector="{StaticResource SettingTemplateSelector}"
                              IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollView>
</Page>
