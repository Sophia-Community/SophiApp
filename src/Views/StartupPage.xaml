<Page
    x:Name="PageStartup"
    x:Class="SophiApp.Views.StartupPage"
    xmlns:controls="using:SophiApp.ControlTemplates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:interaction="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d">
    <Grid>
        <!-- The logo keeps its place whatever is shown under it: the page is split into three parts, and the text takes the lower one -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <controls:AnimatedLogo Grid.Row="1"
                               HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   TextAlignment="Center"
                   Margin="10, 0, 10, 0"/>
    </Grid>
</Page>
