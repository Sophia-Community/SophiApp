<Page
    x:Class="SophiApp.Views.SecurityPage"
    x:Name="PageSecurity"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SophiApp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SecurityViewModel}"
    mc:Ignorable="d">

    <ScrollView x:Name="SecurityScrollView">
        <StackPanel IsHitTestVisible="{x:Bind ViewModel.NavigationViewHitTestVisible, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Uid="Page_Security" Style="{StaticResource PageTitleTextStyle}"/>
            </StackPanel>
            <Grid x:Name="ItemsContainerGrid">
                <ItemsRepeater ItemsSource="{x:Bind Models, Mode=OneWay}"
                               ItemTemplate="{StaticResource SettingTemplateSelector}"
                               VerticalCacheLength="{x:Bind Models.Count, Mode=OneWay}"
                               Margin="{StaticResource SettingsListMargin}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </Grid>
            <Button x:Uid="SecurityPage_OpenEventViewer"
                    Style="{StaticResource AccentButtonStyle}"
                    Margin="0, 10, 0, 20"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.EventViewerButtonIsVisible, Mode=OneWay}"
                    Command="{x:Bind ViewModel.OpenEventViewer_Command, Mode=OneWay}"/>
        </StackPanel>
    </ScrollView>
</Page>
