<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="ApplyCustomizationsPanelBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ApplyCustomizationsPanelForeground" Color="#404040" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFF" Opacity="0.10" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#454545" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0067C0" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F5F5F5" />
            <SolidColorBrush x:Key="ContentBlockBackground" Color="#000000" Opacity="0.24" />
            <SolidColorBrush x:Key="ContentBlockBorder" Color="#FFFFFF" Opacity="0.10" />
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#000000" Opacity="0.24" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#232735" Opacity="0.85"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SetUpCustomizationsPanelBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SetUpCustomizationsPanelForeground" Color="#404040" />
            <SolidColorBrush x:Key="UIControlBackground" Color="#000000" Opacity="0.24" />
            <SolidColorBrush x:Key="UIControlBorderBackground" Color="#FFFFFF" Opacity="0.10" />
            <SolidColorBrush x:Key="UIControlDescriptionForeground" Color="#F5F5F5" />
            <SolidColorBrush x:Key="WindowAccent" Color="#4CC2FF" />
            <SolidColorBrush x:Key="WindowAccentHight" Color="#E20036" />
            <SolidColorBrush x:Key="WindowBackground" Color="#1F2A40" Opacity="0.25" />
            <SolidColorBrush x:Key="WindowForeground" Color="#F5F5F5" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ApplyCustomizationsPanelBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ApplyCustomizationsPanelForeground" Color="#404040" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#000000" Opacity="0.10" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0067C0" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentBlockBackground" Color="#FFFFFF" Opacity="0.70" />
            <SolidColorBrush x:Key="ContentBlockBorder" Color="#000000" Opacity="0.10" />
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FFFFFF" Opacity="0.70" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FCFCFC" Opacity="0.85"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SetUpCustomizationsPanelBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SetUpCustomizationsPanelForeground" Color="#404040" />
            <SolidColorBrush x:Key="UIControlBackground" Color="#FFFFFF" Opacity="0.70" />
            <SolidColorBrush x:Key="UIControlBorderBackground" Color="#000000" Opacity="0.10" />
            <SolidColorBrush x:Key="UIControlDescriptionForeground" Color="#4B4B4B" />
            <SolidColorBrush x:Key="WindowAccent" Color="#0078D4" />
            <SolidColorBrush x:Key="WindowAccentHight" Color="#E20036" />
            <SolidColorBrush x:Key="WindowBackground" Color="Transparent" />
            <SolidColorBrush x:Key="WindowForeground" Color="#4B4B4B" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
