<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The colors of the standard controls are replaced by their own resource keys, the controls stay stock -->

    <!-- The accent is the same whatever accent color is chosen in Windows -->
    <Color x:Key="SystemAccentColor">#0078D4</Color>
    <Color x:Key="SystemAccentColorLight1">#0091F8</Color>
    <Color x:Key="SystemAccentColorLight2">#4CC2FF</Color>
    <Color x:Key="SystemAccentColorLight3">#99EBFF</Color>
    <Color x:Key="SystemAccentColorDark1">#0078D4</Color>
    <Color x:Key="SystemAccentColorDark2">#003E92</Color>
    <Color x:Key="SystemAccentColorDark3">#001A68</Color>

    <!-- There is no high contrast dictionary on purpose: the system colors are used there -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- The page is denser than the menu, which lies on the acrylic of the window -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#D9FCFCFC"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>

            <!-- Text -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#222222"/>
            <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#4B4B4B"/>
            <SolidColorBrush x:Key="SettingsCardForeground" Color="#4B4B4B"/>

            <!-- Menu -->
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#4B4B4B"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#4B4B4B"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#4B4B4B"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#4B4B4B"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#4B4B4B"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#4B4B4B"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#B3FFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <!-- The page is denser than the menu, which lies on the acrylic of the window -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#D9232735"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>

            <!-- Text -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F8F9FC"/>
            <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="SettingsCardForeground" Color="#F5F5F5"/>

            <!-- Menu -->
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#F5F5F5"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
