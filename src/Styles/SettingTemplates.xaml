<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SophiApp.ControlTemplates"
    xmlns:helpers="using:SophiApp.Helpers">

    <!-- Picks the control for a setting: a card with a check box, a card with install buttons or a card with a list of options -->
    <helpers:UIDataTemplateSelector x:Key="SettingTemplateSelector">
        <helpers:UIDataTemplateSelector.InstallTemplate>
            <DataTemplate>
                <controls:SettingInstall/>
            </DataTemplate>
        </helpers:UIDataTemplateSelector.InstallTemplate>
        <helpers:UIDataTemplateSelector.ActionTemplate>
            <DataTemplate>
                <controls:SettingAction/>
            </DataTemplate>
        </helpers:UIDataTemplateSelector.ActionTemplate>
        <helpers:UIDataTemplateSelector.CheckBoxTemplate>
            <DataTemplate>
                <controls:SettingCheckBox/>
            </DataTemplate>
        </helpers:UIDataTemplateSelector.CheckBoxTemplate>
        <helpers:UIDataTemplateSelector.ComboBoxTemplate>
            <DataTemplate>
                <controls:SettingComboBox/>
            </DataTemplate>
        </helpers:UIDataTemplateSelector.ComboBoxTemplate>
        <helpers:UIDataTemplateSelector.UserFoldersTemplate>
            <DataTemplate>
                <controls:SettingUserFolders/>
            </DataTemplate>
        </helpers:UIDataTemplateSelector.UserFoldersTemplate>
        <helpers:UIDataTemplateSelector.AssociationsTemplate>
            <DataTemplate>
                <controls:SettingAssociations/>
            </DataTemplate>
        </helpers:UIDataTemplateSelector.AssociationsTemplate>
        <helpers:UIDataTemplateSelector.CheckListTemplate>
            <DataTemplate>
                <controls:SettingCheckList/>
            </DataTemplate>
        </helpers:UIDataTemplateSelector.CheckListTemplate>
        <!-- The subtitle of a group. Together with the gap between the items it stands 32 px below the previous card and 6 px above the next one -->
        <helpers:UIDataTemplateSelector.GroupHeaderTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2"
                           Margin="1, 28, 0, 2"/>
            </DataTemplate>
        </helpers:UIDataTemplateSelector.GroupHeaderTemplate>
        <helpers:UIDataTemplateSelector.FirstGroupHeaderTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2"
                           Margin="1, 6, 0, 2"/>
            </DataTemplate>
        </helpers:UIDataTemplateSelector.FirstGroupHeaderTemplate>
    </helpers:UIDataTemplateSelector>
</ResourceDictionary>
