<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0,0,0,0</Thickness>
    <!-- The settings panel starts below the title bar (48), so the app title never touches it, however narrow the menu is -->
    <Thickness x:Key="NavigationViewContentMargin">5,48,0,0</Thickness>
    <Thickness x:Key="NavigationViewHeaderMargin">32,22,0,0</Thickness>
    <Thickness x:Key="PageBottomMargin">0, 0, 0, 10</Thickness>
    <Thickness x:Key="SettingsListMargin">0, 0, 24, 10</Thickness>
    <Thickness x:Key="SmallLeftMargin">12,0,0,0</Thickness>
    <Thickness x:Key="SmallTopMargin">0,12,0,0</Thickness>
    <Thickness x:Key="UIControlsPageRightMargin">0, 0, 24, 0</Thickness>
    <Thickness x:Key="XSmallLeftTopRightBottomMargin">8,8,8,8</Thickness>
    <Thickness x:Key="XSmallTopMargin">0,8,0,0</Thickness>

    <!-- The cards of a page are not wider than this, as in the Settings app of Windows -->
    <x:Double x:Key="SettingsContentMaxWidth">1064</x:Double>
</ResourceDictionary>
