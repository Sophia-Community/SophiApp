<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SophiApp.ControlTemplates.LanguageSwitch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The stock button with a menu. The names of the languages are not translated: everyone finds their own -->
    <DropDownButton x:Name="SwitchButton"
                    x:Uid="LanguageSwitch"
                    Visibility="{x:Bind ViewModel.LanguageCanBeChanged, Mode=OneWay}">
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
            <FontIcon Glyph="&#xF2B7;"
                      FontSize="16"/>
            <TextBlock x:Name="CurrentLanguage"/>
        </StackPanel>
        <DropDownButton.Flyout>
            <MenuFlyout x:Name="LanguagesMenu"
                        Placement="BottomEdgeAlignedRight"/>
        </DropDownButton.Flyout>
    </DropDownButton>
</UserControl>
