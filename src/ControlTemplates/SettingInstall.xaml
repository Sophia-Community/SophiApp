<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SophiApp.ControlTemplates.SettingInstall"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SophiApp.Converters"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:SophiApp.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:EnumToBool x:Key="EnumToBoolConverter"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- The package state decides which status and which buttons are shown -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="InstallStates">
                <VisualState x:Name="NotInstalled">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding State, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NotInstalled}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NotInstalledStatus.Visibility" Value="Visible"/>
                        <Setter Target="InstallButton.Visibility" Value="Visible"/>
                        <Setter Target="AllUsersCheckBox.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Installed">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding State, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Installed}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InstalledStatus.Visibility" Value="Visible"/>
                        <Setter Target="UninstallButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="UpdateAvailable">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding State, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=UpdateAvailable}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="UpdateAvailableStatus.Visibility" Value="Visible"/>
                        <Setter Target="UpdateButton.Visibility" Value="Visible"/>
                        <Setter Target="UninstallButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ChangeStates">
                <VisualState x:Name="Changed">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsSelected}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChangedOutline.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- A closed notice takes no room, so the cards stand at the same distance from each other -->
            <VisualStateGroup x:Name="NoticeStates">
                <VisualState x:Name="NoticeShown">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding ExceptionTextIsVisible}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Notice.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel.ContextFlyout>
            <MenuFlyout helpers:PopupCursor.ResetOnOpen="True"
                        helpers:ContextMenuHelper.CopiesNoticeLink="True">
                <MenuFlyoutItem x:Uid="UIModel_ContextMenu_CopyTitle"
                                Icon="Copy"
                                Click="CopyTitle_Click"/>
                <MenuFlyoutItem x:Name="CopyDescriptionButton"
                                x:Uid="UIModel_ContextMenu_CopyDescription"
                                Icon="Copy"
                                Click="CopyDescription_Click"/>
            </MenuFlyout>
        </StackPanel.ContextFlyout>
        <!-- A disabled card takes no clicks, and this background takes the right click for the menu -->
        <Grid Background="Transparent">
            <toolkit:SettingsCard x:Name="Card"
                                  AutomationProperties.Name="{Binding Title}"
                                  IsEnabled="{Binding IsEnabled}">
                <toolkit:SettingsCard.Header>
                    <TextBlock Text="{Binding Title, Converter={StaticResource UnbrokenShortcutsConverter}}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Name="DescriptionText"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <!-- Only some packages can be installed for all users, and the choice matters only before the installation -->
                    <Grid x:Name="AllUsersPanel">
                        <CheckBox x:Name="AllUsersCheckBox"
                                  x:Uid="InstallCard_AllUsers"
                                  MinWidth="0"
                                  Margin="0, 0, 8, 0"
                                  helpers:CheckBoxHelper.IsChecked="{Binding AllUsers, Mode=TwoWay}"
                                  Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock x:Name="NotInstalledStatus"
                               x:Uid="InstallState_NotInstalled"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0, 0, 4, 0"
                               Visibility="Collapsed"/>
                    <!-- A package that is installed and up to date stands out -->
                    <StackPanel x:Name="InstalledStatus"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Margin="0, 0, 4, 0"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE73E;"
                                  FontSize="14"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <TextBlock x:Uid="InstallState_Installed"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateAvailableStatus"
                               x:Uid="InstallState_UpdateAvailable"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0, 0, 4, 0"
                               Visibility="Collapsed"/>
                    <!-- A pressed button means the action is chosen: it is done when the chosen settings are applied -->
                    <ToggleButton x:Name="InstallButton"
                                  x:Uid="Button_Install"
                                  Click="InstallButton_Click"
                                  Visibility="Collapsed"/>
                    <ToggleButton x:Name="UpdateButton"
                                  x:Uid="Button_Update"
                                  Click="InstallButton_Click"
                                  Visibility="Collapsed"/>
                    <!-- Only some packages can be uninstalled -->
                    <Grid x:Name="UninstallPanel">
                        <ToggleButton x:Name="UninstallButton"
                                      x:Uid="Button_Uninstall"
                                      Click="UninstallButton_Click"
                                      Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </toolkit:SettingsCard>
            <!-- Marks a package that is going to be changed -->
            <Border x:Name="ChangedOutline"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
        <!-- The reason why the buttons are unavailable -->
        <InfoBar x:Name="Notice"
                 Visibility="Collapsed"
                 Margin="0, 2, 0, 0"
                 Severity="Warning"
                 IsClosable="False"
                 IsOpen="{Binding ExceptionTextIsVisible}"
                 Message="{Binding ExceptionText}"/>
    </StackPanel>
</UserControl>
