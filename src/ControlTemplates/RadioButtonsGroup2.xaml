<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SophiApp.ControlTemplates.RadioButtonsGroup2"
    x:Name="RadioButtonsGroup2Control"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SophiApp.ControlTemplates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:interaction="using:Microsoft.Xaml.Interactivity"
    xmlns:converters="using:SophiApp.Converters"
    xmlns:models="using:SophiApp.Models"
    d:DataContext="{d:DesignInstance Type=models:UIRadioButtonsGroup2Model}"
    mc:Ignorable="d"
    IsEnabled="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}">
    <interactivity:Interaction.Behaviors>
        <interaction:DataTriggerBehavior Binding="{Binding IsEnabled}" ComparisonCondition="Equal" Value="False">
            <interaction:ChangePropertyAction PropertyName="Opacity" Value="0.6"/>
        </interaction:DataTriggerBehavior>
    </interactivity:Interaction.Behaviors>

    <UserControl.Resources>
        <converters:StringToVisibility x:Key="StringToVisibilityConverter"/>
        <converters:StringToBool x:Key="StringToBoolConverter"/>
        <converters:StringToInverseBool x:Key="StringToInverseBoolConverter"/>
        <CommandBarFlyout x:Name="TextCommandsFlyout">
            <CommandBarFlyout.SecondaryCommands>
                <AppBarButton x:Uid="UIModel_ContextMenu_CopyTitle"
                              Icon="Copy"
                              Click="TextCommandsFlyoutCopyTitle_Click"/>
                <AppBarButton x:Name="CopyDescriptionButton"
                              x:Uid="UIModel_ContextMenu_CopyDescription"
                              Icon="Copy"
                              Click="TextCommandsFlyoutCopyDescription_Click"/>
            </CommandBarFlyout.SecondaryCommands>
        </CommandBarFlyout>
        <Style TargetType="RadioButton">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0, 0, -64, 0"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RadioButtonsGroup2Border"
            Style="{StaticResource UIControlBorderStyle}"
            BorderBrush="{StaticResource UIControlBorderBackground}"
            SizeChanged="Border_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="IsSelectedStatus">
                <VisualState x:Name="SuccessSelected">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsSelected}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RadioButtonsGroup2Border.BorderBrush" Value="{ThemeResource WindowAccent}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Expander Style="{StaticResource UIControlExpanderStyle}"
                  Background="{ThemeResource NavigationViewContentBackground}"
                  ContextRequested="ExpandingRadioGroup_ContextRequested">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Foreground="{ThemeResource WindowAccent}"
                               Margin="0, 10, 0, 0"
                               Visibility="{Binding Path=DebugOptions.ShowFunctionsInfo, ElementName=RadioButtonsGroup2Control}">
                        <Run Text="Function name:"/>
                        <Run Text="{Binding Name}"/>
                        <Run Text="Function Id:"/>
                        <Run Text="{Binding ViewId}"/>
                    </TextBlock>
                    <TextBlock x:Name="TitleTextBlock"
                               Style="{StaticResource UIControlTitleTextStyle}">
                        <Run Text="{Binding Title}"
                             FontSize="{Binding Path=FontOptions.TitleTextSize, ElementName=RadioButtonsGroup2Control}"/>
                    </TextBlock>
                    <TextBlock x:Name="DescriptionTextBlock"
                               Style="{StaticResource UIControlDescriptionTextStyle}"
                               Foreground="{ThemeResource UIControlDescriptionForeground}"
                               Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}">
                        <Run Text="{Binding Description}"
                             FontSize="{Binding Path=FontOptions.DescriptionTextSize, ElementName=RadioButtonsGroup2Control}"/>
                    </TextBlock>
                </StackPanel>
            </Expander.Header>
            <Expander.Content>
                <StackPanel Width="{Binding ElementName=RadioButtonsGroup2Control, Path=UserControlActualWidth, UpdateSourceTrigger=PropertyChanged}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource UIControlTitleTextStyle}"
                                   Margin="0, 5, 10, 7">
                            <Run Text="{Binding Title_1}"
                                 FontSize="{Binding Path=FontOptions.TitleTextSize, ElementName=RadioButtonsGroup2Control}"/>
                        </TextBlock>
                        <RadioButton IsChecked="{Binding SelectedId, Converter={StaticResource StringToBoolConverter}, ConverterParameter=1, Mode=TwoWay}"
                                     IsHitTestVisible="{Binding SelectedId, Converter={StaticResource StringToInverseBoolConverter}, ConverterParameter=1}"
                                     Command="{Binding Path=Command, ElementName=RadioButtonsGroup2Control}"
                                     CommandParameter="{Binding}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource UIControlTitleTextStyle}"
                                   Margin="0, 5, 10, 7">
                            <Run Text="{Binding Title_2}"
                                 FontSize="{Binding Path=FontOptions.TitleTextSize, ElementName=RadioButtonsGroup2Control}"/>
                        </TextBlock>
                        <RadioButton IsChecked="{Binding SelectedId, Converter={StaticResource StringToBoolConverter}, ConverterParameter=2, Mode=TwoWay}"
                                     IsHitTestVisible="{Binding SelectedId, Converter={StaticResource StringToInverseBoolConverter}, ConverterParameter=2}"
                                     Command="{Binding Path=Command, ElementName=RadioButtonsGroup2Control}"
                                     CommandParameter="{Binding}"/>
                    </Grid>
                </StackPanel>
            </Expander.Content>
            <interactivity:Interaction.Behaviors>
                <interaction:DataTriggerBehavior Binding="{Binding Path=Visibility, ElementName=DescriptionTextBlock}" ComparisonCondition="Equal" Value="Collapsed">
                    <interaction:ChangePropertyAction TargetObject="{Binding ElementName=TitleTextBlock}" PropertyName="Margin" Value="0, 20, 10, 20"/>
                </interaction:DataTriggerBehavior>
                <interaction:DataTriggerBehavior Binding="{Binding Path=Visibility, ElementName=DescriptionTextBlock}" ComparisonCondition="Equal" Value="Collapsed">
                    <interaction:ChangePropertyAction TargetObject="{Binding ElementName=CopyDescriptionButton}" PropertyName="IsEnabled" Value="False"/>
                </interaction:DataTriggerBehavior>
            </interactivity:Interaction.Behaviors>
        </Expander>
    </Border>
</UserControl>
