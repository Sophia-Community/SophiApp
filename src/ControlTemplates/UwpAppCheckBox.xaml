<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SophiApp.ControlTemplates.UwpAppCheckBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:SophiApp.Helpers"
    mc:Ignorable="d">

    <!-- A settings card rearranges itself when it is narrow, and a tile of a fixed height has no room for that -->
    <Grid x:Name="Tile"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{ThemeResource ControlCornerRadius}"
          Padding="16, 0, 16, 0"
          ColumnSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ChangeStates">
                <VisualState x:Name="Changed">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsSelected}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Tile.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ContextFlyout>
            <MenuFlyout helpers:PopupCursor.ResetOnOpen="True">
                <MenuFlyoutItem x:Uid="UIModel_ContextMenu_CopyTitle"
                                Icon="Copy"
                                Click="CopyTitle_Click"/>
                <MenuFlyoutItem x:Uid="UIModel_ContextMenu_CopyPackageName"
                                Icon="Copy"
                                Click="CopyPackageName_Click"/>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="AppLogo"
               Grid.Column="0"
               Source="{Binding Image, Mode=OneWay}"
               VerticalAlignment="Center"
               Width="32"
               Height="32"/>
        <StackPanel x:Name="AppNames"
                    Grid.Column="1"
                    VerticalAlignment="Center">
            <!-- A name that does not fit is shown whole in a tooltip -->
            <TextBlock Text="{Binding Name}"
                       TextTrimming="CharacterEllipsis"
                       IsTextTrimmedChanged="Name_IsTextTrimmedChanged"/>
            <TextBlock Text="{Binding Title, Converter={StaticResource UnbrokenShortcutsConverter}}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       IsTextTrimmedChanged="Name_IsTextTrimmedChanged"/>
        </StackPanel>
        <CheckBox Grid.Column="2"
                  AutomationProperties.Name="{Binding Name}"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding IsEnabled}"
                  helpers:CheckBoxHelper.IsChecked="{Binding IsChecked, Mode=TwoWay}"
                  Command="{x:Bind ViewModel.UIUwpAppModelClicked_Command}"
                  CommandParameter="{Binding}"/>
    </Grid>
</UserControl>
