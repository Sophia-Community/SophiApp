<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SophiApp.ControlTemplates.IconCheckBox"
    x:Name="IconCheckBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SophiApp.ControlTemplates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:interaction="using:Microsoft.Xaml.Interactivity"
    xmlns:converters="using:SophiApp.Converters"
    mc:Ignorable="d"
    IsEnabled="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}">
    <interactivity:Interaction.Behaviors>
        <interaction:DataTriggerBehavior Binding="{Binding IsEnabled}" ComparisonCondition="Equal" Value="False">
            <interaction:ChangePropertyAction PropertyName="Opacity" Value="0.6"/>
        </interaction:DataTriggerBehavior>
    </interactivity:Interaction.Behaviors>

    <UserControl.Resources>
        <converters:StringToVisibility x:Key="StringToVisibilityConverter"/>
        <CommandBarFlyout x:Name="TextCommandsFlyout">
            <CommandBarFlyout.SecondaryCommands>
                <AppBarButton x:Uid="UIModel_ContextMenu_CopyTitle"
                              Icon="Copy"
                              Click="TextCommandsFlyoutCopyTitle_Click"/>
                <AppBarButton x:Name="CopyDescriptionButton"
                              x:Uid="UIModel_ContextMenu_CopyDescription"
                              Icon="Copy"
                              Click="TextCommandsFlyoutCopyDescription_Click"/>
            </CommandBarFlyout.SecondaryCommands>
        </CommandBarFlyout>
    </UserControl.Resources>

    <Border x:Name="IconCheckBoxBorder" BorderBrush="{ThemeResource UIControlBorderBackground}"
            Background="{ThemeResource UIControlBackground}"
            Style="{StaticResource UIControlBorderStyle}"
            ContextRequested="IconCheckBox_ContextRequested">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="IsSelectedStatus">
                <VisualState x:Name="SuccessSelected">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsSelected}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="IconCheckBoxBorder.BorderBrush" Value="{ThemeResource WindowAccent}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="54"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="TextPanel"
                        Grid.Column="0"
                        Margin="17, 10, 10, 10"
                        VerticalAlignment="Center">
                <TextBlock x:Name="DebugOptionsTextBlock"
                           Foreground="{ThemeResource WindowAccent}"
                           Visibility="{Binding Path=DebugOptions.ShowFunctionsInfo, ElementName=IconCheckBoxControl}">
                    <Run Text="Function name:"/>
                    <Run Text="{Binding Name}"/>
                    <Run Text="Function Id:"/>
                    <Run Text="{Binding ViewId}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal"
                            Margin="0, 10, 0, 10">
                    <Image x:Name="TitleIcon"
                           Height="24"
                           Width="24"/>
                    <TextBlock x:Name="TitleTextBlock"
                               Style="{StaticResource UIControlTitleTextStyle}"
                               Margin="13, 0, 10, 0"
                               VerticalAlignment="Center">
                        <Run Text="{Binding Title}"
                             FontSize="{Binding Path=FontOptions.TitleTextSize, ElementName=IconCheckBoxControl}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="DescriptionTextBlock"
                           Style="{StaticResource UIControlDescriptionTextStyle}"
                           Foreground="{ThemeResource UIControlDescriptionForeground}"
                           Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}">
                    <Run Text="{Binding Description}"
                         FontSize="{Binding Path=FontOptions.DescriptionTextSize, ElementName=IconCheckBoxControl}"/>
                </TextBlock>
            </StackPanel>
            <CheckBox Grid.Column="1"
                      Style="{StaticResource UIControlCheckBoxStyle}"
                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      Command="{Binding Command, ElementName=IconCheckBoxControl}"
                      CommandParameter="{Binding}"/>
        </Grid>
        <interactivity:Interaction.Behaviors>
            <interaction:DataTriggerBehavior Binding="{Binding Path=Visibility, ElementName=DescriptionTextBlock}" ComparisonCondition="Equal" Value="Collapsed">
                <interaction:ChangePropertyAction TargetObject="{Binding ElementName=CopyDescriptionButton}" PropertyName="IsEnabled" Value="False"/>
            </interaction:DataTriggerBehavior>
            <interaction:DataTriggerBehavior Binding="{Binding Path=IconIndex, ElementName=IconCheckBoxControl, UpdateSourceTrigger=PropertyChanged}" ComparisonCondition="Equal">
                <interaction:DataTriggerBehavior.Value>
                    <x:Int32>0</x:Int32>
                </interaction:DataTriggerBehavior.Value>
                <interaction:ChangePropertyAction TargetObject="{Binding ElementName=TitleIcon}" PropertyName="Source" Value="/Assets/Windows11.svg"/>
            </interaction:DataTriggerBehavior>
            <interaction:DataTriggerBehavior Binding="{Binding Path=IconIndex, ElementName=IconCheckBoxControl, UpdateSourceTrigger=PropertyChanged}" ComparisonCondition="Equal">
                <interaction:DataTriggerBehavior.Value>
                    <x:Int32>1</x:Int32>
                </interaction:DataTriggerBehavior.Value>
                <interaction:ChangePropertyAction TargetObject="{Binding ElementName=TitleIcon}" PropertyName="Source" Value="/Assets/Folder.svg"/>
            </interaction:DataTriggerBehavior>
        </interactivity:Interaction.Behaviors>
    </Border>
</UserControl>
