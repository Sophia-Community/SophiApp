<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SophiApp.ControlTemplates.SettingCheckBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ChangeStates">
                <VisualState x:Name="Changed">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsSelected}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChangedOutline.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel.ContextFlyout>
            <CommandBarFlyout>
                <CommandBarFlyout.SecondaryCommands>
                    <AppBarButton x:Uid="UIModel_ContextMenu_CopyTitle"
                                  Icon="Copy"
                                  Click="CopyTitle_Click"/>
                    <AppBarButton x:Name="CopyDescriptionButton"
                                  x:Uid="UIModel_ContextMenu_CopyDescription"
                                  Icon="Copy"
                                  Click="CopyDescription_Click"/>
                </CommandBarFlyout.SecondaryCommands>
            </CommandBarFlyout>
        </StackPanel.ContextFlyout>
        <Grid>
            <toolkit:SettingsCard x:Name="Card"
                                  IsEnabled="{Binding IsEnabled}">
                <toolkit:SettingsCard.Header>
                    <TextBlock Text="{Binding Title}"
                               TextWrapping="Wrap"
                               FontSize="{x:Bind FontOptions.TitleTextSize, Mode=OneWay}"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Name="DescriptionText"
                               Text="{Binding Description}"
                               TextWrapping="Wrap"
                               FontSize="{x:Bind FontOptions.DescriptionTextSize, Mode=OneWay}"/>
                </toolkit:SettingsCard.Description>
                <CheckBox MinWidth="0"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          Command="{x:Bind ViewModel.UIModelClicked_Command}"
                          CommandParameter="{Binding}"/>
            </toolkit:SettingsCard>
            <!-- Marks a setting that is going to be changed -->
            <Border x:Name="ChangedOutline"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
        <InfoBar Margin="0, 2, 0, 0"
                 Severity="Warning"
                 IsClosable="False"
                 IsOpen="{Binding ExceptionTextIsVisible}"
                 Message="{Binding ExceptionText}"/>
    </StackPanel>
</UserControl>
