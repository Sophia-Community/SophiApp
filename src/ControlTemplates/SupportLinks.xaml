<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SophiApp.ControlTemplates.SupportLinks"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal"
                Spacing="8">
        <HyperlinkButton Command="{x:Bind ViewModel.OpenAppGitHubPage_Command}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="/Assets/GitHub.svg" Width="16" Height="16"/>
                <TextBlock x:Uid="App_GitHub"/>
            </StackPanel>
        </HyperlinkButton>
        <HyperlinkButton Command="{x:Bind ViewModel.OpenAppTelegramPage_Command}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="/Assets/Telegram.svg" Width="16" Height="16"/>
                <TextBlock x:Uid="App_Telegram"/>
            </StackPanel>
        </HyperlinkButton>
        <HyperlinkButton Command="{x:Bind ViewModel.OpenAppDiscordPage_Command}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="/Assets/Discord.svg" Width="16" Height="16"/>
                <TextBlock x:Uid="App_Discord"/>
            </StackPanel>
        </HyperlinkButton>
    </StackPanel>
</UserControl>
