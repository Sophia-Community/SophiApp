<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SophiApp.ControlTemplates.SettingAction"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:SophiApp.Helpers"
    mc:Ignorable="d">

    <StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ChangeStates">
                <VisualState x:Name="Changed">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsSelected}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChangedOutline.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- A closed notice takes no room, so the cards stand at the same distance from each other -->
            <VisualStateGroup x:Name="NoticeStates">
                <VisualState x:Name="NoticeShown">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding ExceptionTextIsVisible}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Notice.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel.ContextFlyout>
            <MenuFlyout helpers:PopupCursor.ResetOnOpen="True"
                        helpers:ContextMenuHelper.CopiesNoticeLink="True">
                <MenuFlyoutItem x:Uid="UIModel_ContextMenu_CopyTitle"
                                Icon="Copy"
                                Click="CopyTitle_Click"/>
                <MenuFlyoutItem x:Name="CopyDescriptionButton"
                                x:Uid="UIModel_ContextMenu_CopyDescription"
                                Icon="Copy"
                                Click="CopyDescription_Click"/>
            </MenuFlyout>
        </StackPanel.ContextFlyout>
        <!-- A disabled card takes no clicks, and this background takes the right click for the menu -->
        <Grid Background="Transparent">
            <toolkit:SettingsCard x:Name="Card"
                                  AutomationProperties.Name="{Binding Title}"
                                  IsEnabled="{Binding IsEnabled}">
                <toolkit:SettingsCard.Header>
                    <TextBlock Text="{Binding Title, Converter={StaticResource UnbrokenShortcutsConverter}}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Name="DescriptionText"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <!-- A pressed button means the action is chosen: it is done when the chosen settings are applied -->
                <ToggleButton x:Name="ActionButton"
                              Content="{Binding ButtonText}"
                              Click="ActionButton_Click"/>
            </toolkit:SettingsCard>
            <!-- Marks an action that is going to be done -->
            <Border x:Name="ChangedOutline"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
        <!-- The reason why the action is unavailable or could not be done -->
        <InfoBar x:Name="Notice"
                 Visibility="Collapsed"
                 Margin="0, 2, 0, 0"
                 Severity="Warning"
                 IsClosable="False"
                 IsOpen="{Binding ExceptionTextIsVisible}"
                 Message="{Binding ExceptionText}"/>
    </StackPanel>
</UserControl>
