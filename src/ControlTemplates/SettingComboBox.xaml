<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SophiApp.ControlTemplates.SettingComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:SophiApp.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- An option: an icon, if there is one, the title, a second line, if there is one, and a link to a web page, if there is one -->
        <DataTemplate x:Key="OptionTemplate"
                      x:DataType="helpers:SettingOption">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- The icon is a picture or a symbol of the icon font -->
                <Grid Width="{x:Bind IconWidth}"
                      Height="26"
                      Margin="0, 0, 12, 0"
                      Visibility="{x:Bind IconVisibility}">
                    <Image Source="{x:Bind Icon}"/>
                    <FontIcon Glyph="{x:Bind Glyph}"
                              FontSize="20"/>
                </Grid>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <!-- A long title goes to the next line in the closed list, so the list does not squeeze the description of the setting -->
                    <TextBlock Text="{x:Bind Title}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind Subtitle}"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7"
                               Visibility="{x:Bind SubtitleVisibility}"/>
                </StackPanel>
                <!-- The arrow opens the web page about the option. The arrows stand in a column at the right edge of the list.
                     It is not a tab stop, so the list is walked with the keyboard as usual -->
                <HyperlinkButton Grid.Column="2"
                                 Tag="{x:Bind Link}"
                                 ToolTipService.ToolTip="{x:Bind LinkHint}"
                                 AutomationProperties.Name="{x:Bind LinkHint}"
                                 Visibility="{x:Bind LinkVisibility}"
                                 Padding="4"
                                 Margin="8, 0, -4, 0"
                                 VerticalAlignment="Center"
                                 IsTabStop="False"
                                 Click="OptionLink_Click">
                    <FontIcon Glyph="&#xE8A7;"
                              FontSize="14"/>
                </HyperlinkButton>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ChangeStates">
                <VisualState x:Name="Changed">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsSelected}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChangedOutline.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- A closed notice takes no room, so the cards stand at the same distance from each other -->
            <VisualStateGroup x:Name="NoticeStates">
                <VisualState x:Name="NoticeShown">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding ExceptionTextIsVisible}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Notice.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- A value set by another setting is an explanation, not a problem -->
            <VisualStateGroup x:Name="LockStates">
                <VisualState x:Name="Locked">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsLocked}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Notice.Severity" Value="Informational"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel.ContextFlyout>
            <MenuFlyout helpers:PopupCursor.ResetOnOpen="True"
                        helpers:ContextMenuHelper.CopiesNoticeLink="True">
                <MenuFlyoutItem x:Uid="UIModel_ContextMenu_CopyTitle"
                                Icon="Copy"
                                Click="CopyTitle_Click"/>
                <MenuFlyoutItem x:Name="CopyDescriptionButton"
                                x:Uid="UIModel_ContextMenu_CopyDescription"
                                Icon="Copy"
                                Click="CopyDescription_Click"/>
            </MenuFlyout>
        </StackPanel.ContextFlyout>
        <!-- A disabled card takes no clicks, and this background takes the right click for the menu -->
        <Grid Background="Transparent">
            <toolkit:SettingsCard x:Name="Card"
                                  AutomationProperties.Name="{Binding Title}"
                                  IsEnabled="{Binding IsEnabled}">
                <toolkit:SettingsCard.Header>
                    <TextBlock Text="{Binding Title, Converter={StaticResource UnbrokenShortcutsConverter}}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.Description>
                    <TextBlock x:Name="DescriptionText"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard.Description>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <!-- Returns to the Windows default. A pressed button means the reset is chosen: it is done when the chosen settings are applied.
                         Only a choice that has such a state shows the button -->
                    <ToggleButton x:Name="ResetButton"
                                  x:Uid="Button_ResetToDefault"
                                  Click="ResetButton_Click"
                                  Visibility="Collapsed"/>
                    <!-- A closed list is narrow, so it leaves the room to the description: a longer option takes several lines.
                         An open list is as wide as its options need and goes to the right of the closed one -->
                    <!-- The style is named: a control derived from the combo box does not get the standard style by itself
                         and looks old, with square corners and a flat list -->
                    <helpers:NoWheelComboBox x:Name="OptionsBox"
                                             x:Uid="ComboBox_NoOption"
                                             Style="{StaticResource DefaultComboBoxStyle}"
                                             AutomationProperties.Name="{Binding Title}"
                                             MinWidth="160"
                                             MaxWidth="344"
                                             HorizontalContentAlignment="Stretch"
                                             SelectionChanged="OptionsBox_SelectionChanged"
                                             DropDownOpened="OptionsBox_DropDownOpened"/>
                </StackPanel>
            </toolkit:SettingsCard>
            <!-- Marks a setting that is going to be changed -->
            <Border x:Name="ChangedOutline"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
        <!-- The reason why the setting is unavailable or could not be applied -->
        <InfoBar x:Name="Notice"
                 Visibility="Collapsed"
                 Margin="0, 2, 0, 0"
                 Severity="Warning"
                 IsClosable="False"
                 IsOpen="{Binding ExceptionTextIsVisible}"
                 Message="{Binding ExceptionText}"/>
    </StackPanel>
</UserControl>
