<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SophiApp.ControlTemplates.SettingCheckList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:SophiApp.Helpers"
    xmlns:models="using:SophiApp.Models"
    mc:Ignorable="d">

    <StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ChangeStates">
                <VisualState x:Name="Changed">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsSelected}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChangedOutline.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- A closed notice takes no room, so the cards stand at the same distance from each other -->
            <VisualStateGroup x:Name="NoticeStates">
                <VisualState x:Name="NoticeShown">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding ExceptionTextIsVisible}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Notice.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel.ContextFlyout>
            <MenuFlyout helpers:PopupCursor.ResetOnOpen="True">
                <MenuFlyoutItem x:Uid="UIModel_ContextMenu_CopyTitle"
                                Icon="Copy"
                                Click="CopyTitle_Click"/>
                <MenuFlyoutItem x:Uid="UIModel_ContextMenu_CopyDescription"
                                Icon="Copy"
                                Click="CopyDescription_Click"/>
            </MenuFlyout>
        </StackPanel.ContextFlyout>
        <Grid>
            <!-- The check box of the card turns all items on or off at once; opened, the card has a check box for each item -->
            <toolkit:SettingsExpander x:Name="Expander"
                                      AutomationProperties.Name="{Binding Title}"
                                      IsEnabled="{Binding IsEnabled}">
                <toolkit:SettingsExpander.Header>
                    <TextBlock Text="{Binding Title, Converter={StaticResource UnbrokenShortcutsConverter}}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsExpander.Header>
                <toolkit:SettingsExpander.Description>
                    <TextBlock x:Name="DescriptionText"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsExpander.Description>
                <!-- Checked if all items are turned on, a dash if only some of them are -->
                <CheckBox x:Name="AllCheckBox"
                          AutomationProperties.Name="{Binding Title}"
                          MinWidth="0"
                          Click="AllCheckBox_Click"/>
                <!-- The rows are not built by the list of the expander: that list builds its rows anew while the page is scrolled -->
                <toolkit:SettingsExpander.ItemsHeader>
                    <ItemsControl ItemsSource="{Binding Items}"
                                  IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CheckListItem">
                                <!-- A row looks like a card of the expander: its check box stands under the check box of the card -->
                                <Grid BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="0, 1, 0, 0"
                                      MinHeight="52"
                                      Padding="16, 8, 44, 8"
                                      ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind SubtitleVisibility}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              AutomationProperties.Name="{x:Bind Title}"
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              Tag="{x:Bind}"
                                              IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                              Click="ItemCheckBox_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </toolkit:SettingsExpander.ItemsHeader>
            </toolkit:SettingsExpander>
            <!-- Marks a setting that is going to be changed -->
            <Border x:Name="ChangedOutline"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
        <InfoBar x:Name="Notice"
                 Visibility="Collapsed"
                 Margin="0, 2, 0, 0"
                 Severity="Warning"
                 IsClosable="False"
                 IsOpen="{Binding ExceptionTextIsVisible}"
                 Message="{Binding ExceptionText}"/>
    </StackPanel>
</UserControl>
