  </data>
  <data name="UIModel_ScheduledTasks_Description" xml:space="preserve">
    <value>Enable the following telemetry-related scheduled tasks in Task Scheduler: MareBackup, Microsoft Compatibility Appraiser, Microsoft Compatibility Appraiser Exp, StartupAppTask, Proxy, Consolidator, UsbCeip, Microsoft-Windows-DiskDiagnosticDataCollector, MapsToastTask, MapsUpdateTask.</value>
  </data>
